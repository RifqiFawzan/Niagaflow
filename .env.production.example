# Contoh isi environment variables untuk deployment.
# Isi nilai sebenarnya di panel hosting (bukan di file ini).
# JANGAN commit file .env / .env.production yang berisi nilai asli.

# --- Backend (apps/api) ---

# Connection string PostgreSQL terkelola (Neon/Supabase/Railway).
# Biasanya wajib ?sslmode=require untuk database terkelola.
DATABASE_URL="postgresql://user:password@host/niagaflow?sslmode=require"

# Port yang didengarkan API. Sebagian hosting mengisi ini otomatis.
PORT=4000

# Origin frontend yang diizinkan (CORS). Harus URL persis, tanpa garis miring di akhir.
# Contoh: https://niagaflow-web.vercel.app
WEB_ORIGIN="https://ganti-dengan-url-frontend"

# Kunci penanda tangan cookie sesi. WAJIB panjang dan acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# WAJIB "production" agar cookie dikirim hanya lewat HTTPS dan SESSION_SECRET dicek.
# CATATAN VERCEL: Vercel sudah menyetel NODE_ENV=production sendiri.
# Jangan isi ulang di panel Vercel, cukup biarkan.
NODE_ENV="production"

# Set "true" bila API berjalan di balik proxy hosting (Vercel, Render, Railway).
# Tanpa ini, IP pengunjung terbaca sebagai IP proxy dan rate limit login salah hitung.
TRUST_PROXY="true"

# Password akun demo saat seed di production. Minimal 12 karakter.
# Dipakai untuk rekruter/pengunjung mencoba aplikasi. Boleh dibagikan di README.
DEMO_PASSWORD="ganti-password-demo-yang-kuat"

# --- Frontend (apps/web, di Vercel) ---

# URL backend, tanpa garis miring di akhir. Ditanam saat build.
# Kalau nilainya diubah, frontend harus di-deploy ulang.
VITE_API_URL="https://ganti-dengan-url-backend"
