# Salin ke apps/api/.env lalu isi sesuai mesinmu.
#
# Cara termudah di Windows tanpa instal PG lokal — jalankan container dev:
#   docker run -d --name niagaflow-pg -e POSTGRES_PASSWORD=niagaflow_dev_2026 \
#     -e POSTGRES_DB=niagaflow -p 5433:5432 -v niagaflow-pgdata:/var/lib/postgresql/data postgres:17-alpine
DATABASE_URL="postgresql://postgres:niagaflow_dev_2026@localhost:5433/niagaflow?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
SESSION_SECRET="ganti-dengan-string-acak-panjang"
