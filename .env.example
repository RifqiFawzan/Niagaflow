# Salin file ini ke apps/api/.env lalu isi sesuai mesinmu.
#
# Cara termudah di Windows tanpa memasang PostgreSQL lokal -- jalankan container dev:
#   docker run -d --name niagaflow-pg -e POSTGRES_PASSWORD=ganti_password_ini \
#     -e POSTGRES_DB=niagaflow -p 5433:5432 -v niagaflow-pgdata:/var/lib/postgresql/data postgres:17-alpine
#
# Sesuaikan password di DATABASE_URL dengan POSTGRES_PASSWORD di atas.
DATABASE_URL="postgresql://postgres:ganti_password_ini@localhost:5433/niagaflow?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Hasilkan string acak panjang, jangan pakai contoh ini di production.
SESSION_SECRET="ganti-dengan-string-acak-panjang"
